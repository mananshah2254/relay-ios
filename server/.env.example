# Generate a 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORE_KEY_HEX=
DATA_DIR=./data
HOST=127.0.0.1
PORT=8787
# Use the externally reachable HTTPS origin for a phone and OAuth callback.
PUBLIC_BASE_URL=http://localhost:8787
# Google Cloud OAuth client type: Web application.
# Register PUBLIC_BASE_URL + /v1/google/callback as an exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these comma-separated recipients can receive mail during a pilot.
# Strongly recommended while testing with real Gmail credentials.
TEST_RECIPIENT_ALLOWLIST=
# Set only behind the supplied Caddy proxy on the same VM.
TRUST_LOOPBACK_PROXY=false
